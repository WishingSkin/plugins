{
  "manifest": {
    "id": "wishingskin.skin-overlays",
    "name": "皮肤装扮叠层",
    "description": "在保留原有皮肤的前提下叠加节日帽饰、王冠、护目镜或围巾等透明装饰层，一键合成并穿戴。",
    "version": "0.1.0",
    "settingsNamespace": "wishingskin.skin-overlays",
    "migrationVersion": 0,
    "permissions": [
      "routes.user",
      "routes.admin",
      "frontend",
      "user.frontend",
      "database",
      "host.textures.read",
      "host.textures.write",
      "host.characters.write",
      "host.points.spend"
    ],
    "settings": [
      { "key": "points_cost", "label": "每次合成消耗积分（0 为免费，需启用积分插件）", "type": "number" },
      { "key": "max_layers", "label": "单次最多叠加层数（默认 3，范围 1–5）", "type": "number" },
      { "key": "allow_public_save", "label": "允许用户将合成后的皮肤直接设为公开", "type": "boolean" }
    ]
  },
  "protocol": 2,
  "routes": [
    { "method": "GET", "path": "/overlays", "access": "user" },
    { "method": "POST", "path": "/preview", "access": "user" },
    { "method": "POST", "path": "/apply", "access": "user" },
    { "method": "GET", "path": "/admin/overlays", "access": "admin" },
    { "method": "POST", "path": "/admin/overlays", "access": "admin" },
    { "method": "POST", "path": "/admin/overlays/delete", "access": "admin" }
  ],
  "frontend": "admin.html",
  "userFrontends": [
    {
      "id": "studio",
      "label": "皮肤装扮叠层",
      "description": "为现有皮肤叠加节日帽饰、王冠、护目镜或围巾，一键预览、保存与穿戴。",
      "slot": "user.tools",
      "path": "studio.html"
    },
    {
      "id": "decorate",
      "label": "叠加装饰层",
      "description": "给当前皮肤叠加节日或个性化透明装饰层。",
      "slot": "texture.action",
      "path": "studio.html",
      "kinds": ["skin"]
    }
  ]
}
