{
  "manifest": {
    "id": "wishingskin.ai-skin",
    "name": "AI 皮肤工坊（测试版）",
    "description": "【测试版】通过自然语言描述生成标准 64×64 Minecraft 皮肤，支持纯文本 D2-Strict 像素精绘、云端图像 B2-v2 正交投影及外部算力节点，含 UV 清洗、配额与积分控制。",
    "version": "0.1.0-beta.1",
    "settingsNamespace": "wishingskin.ai-skin",
    "migrationVersion": 0,
    "permissions": [
      "routes.user",
      "routes.admin",
      "frontend",
      "user.frontend",
      "database",
      "host.public.read",
      "host.users.read",
      "host.textures.write",
      "host.characters.write",
      "host.points.spend"
    ],
    "settings": [
      {
        "key": "default_engine",
        "label": "默认生成引擎",
        "type": "text",
        "default": "",
        "description": "当站点配置了多种生成引擎时优先使用的引擎",
        "options": [
          { "value": "structured_llm", "label": "纯文本 AI 像素精绘 (D2-Strict)" },
          { "value": "image_api", "label": "云端图像正交投影 (B2-v2)" },
          { "value": "async_worker", "label": "外部专用算力节点" },
          { "value": "local_demo", "label": "内置本地演示引擎" }
        ]
      },
      {
        "key": "llm_api_url",
        "label": "文本模型 Chat API 地址",
        "type": "text",
        "description": "OpenAI 兼容接口，例如 https://api.openai.com/v1/chat/completions"
      },
      {
        "key": "llm_api_key",
        "label": "文本模型 API Key",
        "type": "secret"
      },
      {
        "key": "llm_model",
        "label": "文本模型名称",
        "type": "text",
        "default": "gpt-4o-mini",
        "description": "纯文本像素精绘所使用的模型标识（建议推理/多模态模型或 DeepSeek/GPT）"
      },
      {
        "key": "llm_render_mode",
        "label": "文本引擎生成策略",
        "type": "text",
        "default": "pixel_grid",
        "description": "默认使用 D2-Strict 分面像素网格直绘，也可切回旧版参数配方",
        "options": [
          { "value": "pixel_grid", "label": "分面像素网格精绘 (D2-Strict，推荐)" },
          { "value": "recipe", "label": "结构配方模板合成 (旧版)" }
        ]
      },
      {
        "key": "image_api_url",
        "label": "图像模型 API 地址",
        "type": "text",
        "description": "OpenAI Images 兼容接口地址，可选"
      },
      {
        "key": "image_api_key",
        "label": "图像模型 API Key",
        "type": "secret"
      },
      {
        "key": "image_model",
        "label": "图像模型名称",
        "type": "text",
        "default": "gpt-image-1",
        "description": "图像生成接口所使用的模型标识"
      },
      {
        "key": "image_api_mode",
        "label": "图像引擎投影模式",
        "type": "text",
        "default": "ortho_b2",
        "description": "默认生成正交前后双视图并量化投影，比直出 UV 贴图更稳定",
        "options": [
          { "value": "ortho_b2", "label": "正交前后双视图投影 + 36 色量化 (B2-v2，推荐)" },
          { "value": "direct_uv", "label": "直接生成 64×64 UV 展开图 (仅兼容微调模型)" }
        ]
      },
      {
        "key": "worker_url",
        "label": "外部自定义推理节点 URL",
        "type": "text",
        "description": "支持同步 PNG 或异步任务轮询的 HTTP 推理节点，可选"
      },
      {
        "key": "worker_secret",
        "label": "外部推理节点鉴权密钥",
        "type": "secret",
        "description": "作为 Bearer Token 发送给外部推理节点，可选"
      },
      {
        "key": "allow_private_worker",
        "label": "允许连接内网或局域网推理节点 IP",
        "type": "boolean",
        "default": false,
        "description": "关闭时仅允许公网 HTTPS 或本机回环地址"
      },
      {
        "key": "allow_local_fallback",
        "label": "启用内置免密钥本地演示引擎",
        "type": "boolean",
        "default": false,
        "description": "基于关键词配色合成本地皮肤，供无外部 API 时体验"
      },
      {
        "key": "points_cost",
        "label": "每次生成消耗积分",
        "type": "number",
        "default": 0,
        "description": "0 为免费，生成成功且 UV 校验通过后再扣费"
      },
      {
        "key": "daily_limit",
        "label": "每名用户每日成功生成上限",
        "type": "number",
        "default": 5,
        "description": "设为 0 表示仅管理员可用"
      },
      {
        "key": "cooldown_seconds",
        "label": "同一用户两次提交冷却秒数",
        "type": "number",
        "default": 15,
        "description": "普通用户连续提交的最小间隔时间"
      },
      {
        "key": "allow_public_save",
        "label": "允许用户将 AI 生成的皮肤直接设为公开",
        "type": "boolean",
        "default": false
      },
      {
        "key": "timeout_seconds",
        "label": "单次 AI 任务超时秒数",
        "type": "number",
        "default": 90,
        "description": "有效范围 15 至 240 秒，留空或 0 时使用默认 90 秒"
      }
    ]
  },
  "protocol": 2,
  "routes": [
    { "method": "GET", "path": "/config", "access": "user" },
    { "method": "POST", "path": "/generate", "access": "user" },
    { "method": "GET", "path": "/jobs", "access": "user" },
    { "method": "GET", "path": "/history", "access": "user" },
    { "method": "POST", "path": "/history/delete", "access": "user" },
    { "method": "POST", "path": "/save", "access": "user" },
    { "method": "GET", "path": "/admin/status", "access": "admin" },
    { "method": "POST", "path": "/admin/test", "access": "admin" },
    { "method": "POST", "path": "/admin/clear-logs", "access": "admin" }
  ],
  "frontend": "admin.html",
  "userFrontends": [
    {
      "id": "studio",
      "label": "AI 皮肤工坊（测试版）",
      "description": "【测试版】输入文字描述即可生成标准 64×64 Minecraft 皮肤，支持局部微调、一键送入编辑器精修、预览、保存与角色穿戴。",
      "slot": "user.tools",
      "path": "studio.html"
    }
  ]
}
