{
  "manifest": {
    "id": "wishingskin.moderation",
    "name": "合规校验与内容审核",
    "description": "为角色名、昵称与材质上传提供同步敏感词、正则规则、图像健康度检测与外部审核接口校验。",
    "version": "0.1.0",
    "settingsNamespace": "wishingskin.moderation",
    "migrationVersion": 0,
    "permissions": ["hooks", "hooks.image", "routes.admin", "frontend", "database"],
    "settings": [
      {
        "key": "mode",
        "label": "命中处理模式",
        "type": "text",
        "default": "block",
        "description": "触发词表时直接拦截拒绝或将材质转入人工审核",
        "options": [
          { "value": "block", "label": "直接拒绝" },
          { "value": "review", "label": "材质转人工审核" }
        ]
      },
      {
        "key": "blocked_words",
        "label": "敏感词列表",
        "type": "text",
        "description": "多个词汇可用逗号或换行分隔"
      },
      {
        "key": "review_words",
        "label": "人工复核词列表",
        "type": "text",
        "description": "多个词汇可用逗号或换行分隔"
      },
      {
        "key": "regex_rules",
        "label": "正则拦截规则",
        "type": "text",
        "description": "每行一条 RE2 表达式，最多 32 条"
      },
      {
        "key": "reject_blank_skin",
        "label": "拦截有效像素过少的透明空白材质",
        "type": "boolean",
        "default": false
      },
      {
        "key": "reject_solid_skin",
        "label": "纯单色材质自动转入人工审核",
        "type": "boolean",
        "default": false
      },
      {
        "key": "webhook_url",
        "label": "外部内容审核接口 URL",
        "type": "text",
        "description": "可选，支持 HTTPS 或本机回环 HTTP"
      },
      {
        "key": "webhook_secret",
        "label": "外部审核接口密钥",
        "type": "secret",
        "description": "可选，作为 Bearer Token 发送"
      },
      {
        "key": "webhook_fail_policy",
        "label": "外部接口异常回退策略",
        "type": "text",
        "default": "allow",
        "description": "外部接口超时或请求异常时的默认处理策略",
        "options": [
          { "value": "allow", "label": "放行" },
          { "value": "review", "label": "转人工审核" },
          { "value": "reject", "label": "拒绝" }
        ]
      },
      {
        "key": "webhook_send_image",
        "label": "调用外部审核接口时附带上传图片 Base64",
        "type": "boolean",
        "default": false
      }
    ]
  },
  "protocol": 2,
  "hooks": ["text.check", "texture.upload.check"],
  "routes": [
    { "method": "GET", "path": "/status", "access": "admin" },
    { "method": "POST", "path": "/test", "access": "admin" },
    { "method": "POST", "path": "/clear-logs", "access": "admin" }
  ],
  "frontend": "admin.html"
}
